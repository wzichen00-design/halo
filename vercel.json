{
  "version": 2,
  "builds": [
    {
      "src": "ui/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "ui/build/dist/ui",
        "buildCommand": "cd ui && pnpm install && pnpm run build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "console.html",
      "status": 200
    }
  ]
}

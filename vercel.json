{
  "version": 2,
  "env": {
    "NODE_VERSION": "20"
  },
  "builds": [
    {
      "src": "ui/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build/dist/ui",
        "buildCommand": "cd ui && npm install -g pnpm@10.30.3 && pnpm install --frozen-lockfile && pnpm run build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "console.html",
      "status": 200
    }
  ]
}
